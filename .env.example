# Local/demo Docker Compose values. Copy to .env for local overrides.
# Public deployments must replace all secrets and public URLs.

POSTGRES_DB=gateway_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/gateway_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MS=3600000
ADMIN_REFRESH_TOKEN_EXPIRATION_MS=604800000

BACKEND_SERVICE_URL=http://backend-service:8081
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Browser-visible URL embedded into the management-ui bundle at build time.
# Use the public gateway/admin API URL for deployments, not Docker-internal hostnames.
VITE_API_BASE_URL=http://localhost:8080
