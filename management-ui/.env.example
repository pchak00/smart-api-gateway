# API Base URL
# Vite embeds this browser-visible value into the static bundle at build time.
# Use / for Vite dev proxy mode, http://localhost:8080 for local Compose,
# or the public gateway/admin API URL for deployment.
# Do not use Docker-internal hostnames such as http://gateway-service:8080 here.
VITE_API_BASE_URL=http://localhost:8080
